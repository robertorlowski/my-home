# Wzór server/.env do pracy lokalnej (plik .env jest poza gitem). Na serwerze w środowisku jest tylko MONGODB_URI,
# reszta jest w kolekcji app_settings (ekran konta systemowego); wartość z bazy ma pierwszeństwo.
# Znaki specjalne w haśle kodować w adresie: ! -> %21, @ -> %40, : -> %3A, # -> %23.
MONGODB_URI=mongodb+srv://<użytkownik>:<hasło>@hp.e4k0pox.mongodb.net/hpdb?retryWrites=true&w=majority&appName=hp
PORT=3001

# Konta użytkowników (2026-10-11)
# adres klienta (linki w mailach z kodem, usunięciem konta i zaproszeniem); kilka adresów po przecinku
CLIENT_URL=https://home24.onrender.com,https://myhome24.onrender.com
# SMTP (Office 365); bez SMTP_HOST maile tylko w logu serwera
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# nadawca (bez „Send As” do niego mail idzie z SMTP_USER, odpowiedzi na MAIL_FROM)
MAIL_FROM=
# powiadomienia o nowych kontach
MAIL_ADMIN=
# adres, na który idzie kod logowania konta system („system” w polu e-mail; od 2026-11-13 bez hasła, SYSTEM_PASSWORD
# nie jest używane); puste = MAIL_ADMIN, bez obu albo bez SMTP_HOST kod jest tylko w logu serwera
SYSTEM_EMAIL=

# Kod z aplikacji na telefonie (TOTP, od 2026-11-13), tylko w środowisku (nie w bazie): klucz szyfrujący sekrety telefonów
# (32 bajty w zwykłym base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"; na serwerze ten
# sam co w Archiwum) i nazwa wspólnej bazy kluczy (domyślnie logowanie). Bez klucza kod z telefonu jest wyłączony.
LOGOWANIE_KLUCZ=
LOGIN_KEYS_DB=

# Powiadomienia Web Push (2026-10-21): klucze VAPID (raz: npx web-push generate-vapid-keys w server/);
# bez nich powiadomienia są wyłączone. VAPID_SUBJECT to mailto: administratora.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Wersja demo (2026-10-21): publiczny podgląd konta tego właściciela tylko do odczytu („Zobacz wersję demo” pod logowaniem);
# bez wartości przycisku nie ma
DEMO_OWNER_EMAIL=
